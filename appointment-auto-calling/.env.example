# Supabase project URL and public anon key (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service role key. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_KEY=

# Shared bearer secret configured in Bolna for /api/book-appointment and
# /api/check-availability. Configure the same value in Vercel and Bolna.
AGENT_SECRET=
